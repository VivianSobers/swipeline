{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:swipeline:auth-proposal:v1",
  "allOf": [{"$ref": "urn:swipeline:auth-request:v1"}],
  "type": "object",
  "required": ["proposal_id", "decision", "reason", "fraud_flags", "score", "velocity_60s", "usual_minor", "spend_ratio", "merchant_distinct_estimate", "features_late", "scored_at_ms"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["APPROVE", "DECLINE"]},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z_]{0,63}$"},
    "fraud_flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["CARD_TESTING", "CARD_VELOCITY", "SPEND_ANOMALY"]}},
    "score": {"type": "integer", "minimum": 0, "maximum": 180},
    "velocity_60s": {"type": "integer", "minimum": 0},
    "usual_minor": {"type": "integer", "minimum": 100, "maximum": 9223372036854775807},
    "spend_ratio": {"type": "number", "minimum": 0},
    "merchant_distinct_estimate": {"type": "number", "minimum": 0},
    "features_late": {"type": "boolean"},
    "scored_at_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
