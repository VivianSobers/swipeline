{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "swipeline_decisions",
      "timestampSpec": {"column": "finalized_at_ms", "format": "millis"},
      "dimensionsSpec": {
        "dimensions": [
          "run_id", "transaction_id", "decision_id", "merchant_id", "mcc",
          "issuer_bank_id", "acquirer_bank_id", "currency", "decision", "reason",
          "decision_source", "rule_version", "reference_version", "fraud_flags",
          "features_late",
          {"name": "amount_minor", "type": "long"},
          {"name": "event_time_ms", "type": "long"},
          {"name": "decision_latency_ms", "type": "double"},
          {"name": "score", "type": "long"},
          {"name": "velocity_60s", "type": "long"},
          {"name": "spend_ratio", "type": "double"},
          {"name": "merchant_distinct_estimate", "type": "double"}
        ]
      },
      "metricsSpec": [],
      "granularitySpec": {
        "type": "uniform", "segmentGranularity": "HOUR",
        "queryGranularity": "NONE", "rollup": false
      }
    },
    "ioConfig": {
      "type": "kafka", "topic": "swipeline.decisions.v1",
      "inputFormat": {"type": "json"},
      "consumerProperties": {
        "bootstrap.servers": "kafka:9092", "isolation.level": "read_committed"
      },
      "useEarliestOffset": true, "taskCount": 1, "replicas": 1,
      "taskDuration": "PT1H"
    },
    "tuningConfig": {
      "type": "kafka", "maxRowsInMemory": 10000,
      "maxRowsPerSegment": 200000, "maxParseExceptions": 0
    }
  }
}
